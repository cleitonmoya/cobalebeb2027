#!/bin/bash
#PBS -N excl_check
#PBS -j oe
#PBS -o excl_check.out
#PBS -l select=1:ncpus=2
#PBS -l place=excl
#PBS -l walltime=00:03:00

echo "===================================================="
echo "Job ID:        $PBS_JOBID"
echo "Node (Mom):    $(hostname)"
echo "Queue:         $PBS_QUEUE"
echo "Start time:    $(date)"
echo "Requested ncpus (from PBS_NODEFILE lines): $(wc -l < $PBS_NODEFILE)"
echo "===================================================="
echo

echo "---- nproc (CPUs visible to this job, per cgroup/affinity) ----"
nproc
echo

echo "---- /proc/cpuinfo: processor vs core id ----"
echo "(processor = logical thread; core id = physical core identifier)"
echo

grep -E '^processor|^core id|^physical id' /proc/cpuinfo

echo
echo "---- Summary ----"
N_LOGICAL=$(grep -c '^processor' /proc/cpuinfo)
N_PHYSICAL=$(grep '^core id' /proc/cpuinfo | sort -u | wc -l)
echo "Total logical processors visible on this node: $N_LOGICAL"
echo "Total UNIQUE physical core ids visible on this node: $N_PHYSICAL"
echo

echo "---- taskset: which CPUs is this job actually pinned/allowed to use? ----"
taskset -cp $$
echo

echo "---- cgroup cpuset (if available) ----"
if [ -f /sys/fs/cgroup/cpuset/cpuset.cpus ]; then
    cat /sys/fs/cgroup/cpuset/cpuset.cpus
elif [ -f /sys/fs/cgroup/cpuset.cpus.effective ]; then
    cat /sys/fs/cgroup/cpuset.cpus.effective
else
    echo "(no cgroup cpuset file found at expected paths)"
fi

echo
echo "---- Checking node exclusivity (any other jobs on this node?) ----"
echo "(run manually now, while this job sleeps: pbsnodes -a | grep -A20 $(hostname))"
echo "Sleeping 60s to allow manual pbsnodes -a check..."
sleep 60
echo "Done sleeping."
echo

echo "End time:      $(date)"
echo "===================================================="
