#!/bin/bash
## Teste isolado: MESMO perfil de recursos do calibration_aggregate.pbs
## (ncpus=18, place=excl, walltime>6h -> Parallel_longX), SEM host= fixo
## (deixa o scheduler escolher livremente) e SEM nenhum codigo nosso --
## so echo/hostname/date. Objetivo: descobrir se o padrao de falha
## ("held, too many failed attempts to run" apos 21 tentativas, minutos
## ou segundos depois) e sobre o PERFIL DE RECURSOS/fila em si (qualquer
## job assim falha, em qualquer no), ou e algo especifico do conteudo do
## calibration_aggregate.pbs.
##
## Rode varias vezes seguidas (nao apague o log entre execucoes -- >> no
## echo final acumula um registro de qual no cada tentativa pegou e se
## deu certo) para juntar uma amostra decente antes de decidir se e
## mesmo infraestrutura ou nosso lado.

#PBS -N teste_perfil_recursos
#PBS -j oe
#PBS -k oe
#PBS -o teste_perfil_recursos.log
#PBS -l select=1:ncpus=18
#PBS -l place=excl
#PBS -l walltime=06:30:00

echo "===================================================="
echo "PBS job ID:      $PBS_JOBID"
echo "Node (hostname): $(hostname)"
echo "Data/hora:       $(date)"
echo "===================================================="
echo "teste ok"
