#!/bin/bash
#PBS -N <%= job.name %>
#PBS -l select=1:ncpus=<%= resources$ncpus %>
#PBS -l place=excl
#PBS -l walltime=<%= { total_min <- round(resources$walltime_hours * 60); sprintf("%02d:%02d:00", total_min %/% 60, total_min %% 60) } %>
#PBS -j oe
#PBS -o /dev/null

# No -q directive: let RouteQ decide (Seq_short/Seq_long cap ncpus at 1,
# so ncpus=20 can only be routed to Parallel_*). Every job was landing in
# Parallel_shortX during earlier testing -- confirmed by Euler support via
# email to be a walltime effect, not something about ncpus/place=excl:
# walltime <= 6h routes to "fila paralela curta" (only 2 nodes allocated
# there at the time of that reply, max ~4 concurrent place=excl jobs);
# walltime > 6h routes to "fila paralela longa" instead (14 free nodes at
# the time of that reply, 160-ncpus quota becomes the real limit -- 8
# concurrent place=excl jobs, the concurrency this file's CHUNK_SIZE-based
# chunking is built around). This is why walltime_hours_for() in
# simulation.R always returns a value above 6h now, for every category.

# Redirect all output directly, from inside the script, to the same NFS
# path batchtools expects the log at -- instead of relying on PBS's own
# -o/-j oe stage-out mechanism. That mechanism (absolute, hostname-
# qualified NFS path in Output_Path) delivered nothing during testing
# (Exit_status=0, job ran and wrote its real results correctly, but
# neither the PBS spool .OU file nor the batchtools log destination ever
# received any content -- Stageout_status=1, exact meaning unconfirmed
# even against the PBS Pro reference docs). Direct NFS writes from the
# compute node are already proven reliable all session (every .rds result
# file is written this same way), so this sidesteps PBS's separate
# staging subsystem entirely instead of depending on it.
exec > "<%= log.file %>" 2>&1

echo "=== PBS job diagnostics ==="
echo "PBS_JOBID:  $PBS_JOBID"
echo "PBS_QUEUE:  $PBS_QUEUE"
echo "hostname:   $(hostname)"
echo "Submitted:  $(date)"
echo "==========================="

source ~/setup_env.sh

cd ~/cobalebeb2027/simulation

Rscript -e 'batchtools::doJobCollection("<%= uri %>")'
